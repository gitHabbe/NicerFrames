<Ui
    xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd"
>
   	<Script File="PlayerFrameCustom.lua" />
	<Button
        name="PlayerFrameCustom"
        inherits="SecureUnitButtonTemplate"
        virtual="true"
        movable="true"
        enableMouse="true"
    >
  		<Layers>
 			<Layer level="BACKGROUND">
				<Texture name="$parentBackground">
    				<Color r="0" g="1" b="0" a="1" />
				</Texture>
 			</Layer>
  		</Layers>
  		<Layers>
 			<Layer level="BACKGROUND">
				<Texture name="$parentDebugBackground" hidden="false">
                    <Color r="1" g="0" b="0" a="1" />
				</Texture>
 			</Layer>
  		</Layers>
		<Frames>
		    <!-- Portraits -->
			<Frame name="$parentPortrait" frameStrata="LOW" frameLevel="1">
				<Layers>
					<Layer level="BORDER">
						<Texture name="$parentTexture">
						</Texture>
					</Layer>
				</Layers>
			</Frame>
			<Frame
                name="$parentReadyCheck"
                inherits="ReadyCheckStatusTemplate"
                hidden="true"
                frameStrata="LOW"
                frameLevel="3"
            >
			</Frame>
			<Frame name="$parentGroupIndicatorParent" hidden="true">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentGroupIndicatorLeft">
						</Texture>
						<Texture name="$parentGroupIndicatorRight">
						</Texture>
						<Texture name="$parentGroupIndicatorMiddle">
						</Texture>
						<FontString name="$parentGroupIndicatorText" inherits="GameFontHighlightSmall">
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<!-- DruidBar -->
			<Frame name="$parentDruidBar" frameStrata="LOW" frameLevel="1">
    			<Frames>
         			<StatusBar name="$parentStatus" frameStrata="LOW" frameLevel="1">
             			<Layers>
           					<Layer level="BACKGROUND">
          						<Texture name="$parentBackground">
                                    <Color r="0" g="0" b="0" a="0.5" />
          						</Texture>
           					</Layer>
                            <Layer level="ARTWORK">
               					<FontString name="$parentText" inherits="GameFontHighlightSmall" />
                            </Layer>
             			</Layers>
                        <BarTexture file="Interface\TargetingFrame\UI-StatusBar" />
                    </StatusBar>
                    <Frame name="$parentParent" frameStrata="MEDIUM" frameLevel="5">
                        <Layers>
                            <Layer level="ARTWORK">
                     			<Texture name="$parentLeft" />
                     			<Texture name="$parentRight" />
                     			<Texture name="$parentMiddle" />
                            </Layer>
                        </Layers>
                    </Frame>
    			</Frames>
			</Frame>
			<!-- NameBar -->
			<Frame name="$parentNameBar" frameStrata="LOW" frameLevel="1" hidden="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentTexture">
                            <Color r="1" g="0" b="0" a="1" />
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>
            <!-- HealthBar -->
			<StatusBar name="$parentHealthBar">
				<Layers>
   					<Layer level="BACKGROUND">
  						<Texture name="$parentBackground">
                            <Color r="0" g="1" b="0" a="1" />
  						</Texture>
   					</Layer>
   					<Layer level="ARTWORK">
  						<FontString name="$parentText" inherits="GameFontNormal" hidden="true">
  						</FontString>
   					</Layer>
    				<Layer level="ARTWORK">
       					<FontString name="$parentNameText" inherits="GameFontNormalSmall">
        				</FontString>
                    </Layer>
				</Layers>
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar" />
 			</StatusBar>
			<!-- PowerBar -->
			<StatusBar name="$parentPowerBar">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentBackground">
				        	<Color r="0" g="1" b="0" a="1" />
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString name="$parentText" inherits="GameFontNormal">
						</FontString>
					</Layer>
				</Layers>
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar" />
			</StatusBar>
			<!-- TextureFrame -->
			<Frame name="$parentTextureFrame" frameStrata="MEDIUM" frameLevel="5">
				<Layers>
					<Layer level="BACKGROUND">
						<Texture
                            name="$parentTexture"
                            file="Interface\TargetingFrame\UI-TargetingFrame"
                        >
						</Texture>
					</Layer>
					<Layer level="BORDER">
						<Texture
                            name="$parentPortraitBorderTexture"
                            file="Interface\AddOns\NicerFrames\Textures\UnitFrames\Class-Circle-Cutout"
                        >
							<Color r="1.00" g="0.96" b="0.41" />
						</Texture>
					</Layer>
					<!-- Level Text -->
    				<Layer level="OVERLAY">
    					<FontString name="$parentLevelText" inherits="GameFontNormalSmall">
    					</FontString>
    				</Layer>
                    <Layer level="BORDER">
       					<Texture name="$parentBossSkull" file="Interface\TargetingFrame\UI-TargetingFrame-Skull" hidden="true">
       						<Size>
       							<AbsDimension x="16" y="16"/>
       						</Size>
       						<Anchors>
       							<Anchor point="CENTER" relativeTo="$parentLevelText">
       								<Offset>
       									<AbsDimension x="0" y="0"/>
       								</Offset>
       							</Anchor>
       						</Anchors>
       					</Texture>
					</Layer>
                    <!-- Master Looter -->
              		<Layer level="OVERLAY">
                        <Texture
                            name="$parentMasterIcon"
                            file="Interface\GroupFrame\UI-Group-MasterLooter"
                            hidden="true"
                        >
						</Texture>
					</Layer>
                    <!-- Leader Icon -->
                    <Layer level="OVERLAY">
                        <Texture
                            name="$parentLeaderIcon"
                            file="Interface\GroupFrame\UI-Group-LeaderIcon"
                            hidden="true"
                        >
						</Texture>
                    </Layer>
                    <!-- Rest Icon -->
                    <Layer level="OVERLAY">
                        <Texture
                            name="$parentRestIcon"
                            file="Interface\CharacterFrame\UI-StateIcon"
                            hidden="true"
                        >
						</Texture>
					</Layer>
					<!-- Combat Icon -->
                    <Layer level="OVERLAY">
                        <Texture
                            name="$parentCombatIcon"
                            file="Interface\CharacterFrame\UI-StateIcon"
                            hidden="true"
                        >
    					</Texture>
                    </Layer>
                    <!-- PVP Icon -->
                    <Layer level="OVERLAY">
                        <Texture
                            name="$parentPVPIcon"
                            file="Interface\TargetingFrame\UI-PVP-FFA"
                            hidden="true"
                        >
						</Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture
                            name="$parentRaidTargetIcon"
                            file="Interface\TargetingFrame\UI-RaidTargetingIcons"
                            hidden="true"
                        >
						</Texture>
                    </Layer>
                    <Layer level="OVERLAY">
						<FontString
                            name="$parentHitIndicator"
                            hidden="true"
                            inherits="NumberFontNormalHuge"
                        >
						</FontString>
					</Layer>
					<Layer level="BORDER">
						<Texture
                            name="$parentStatusTexture"
                            file="Interface\CharacterFrame\UI-Player-Status"
                            hidden="true"
                            alphaMode="ADD"
                        >
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<Texture
                            name="$parentRestGlow"
                            file="Interface\CharacterFrame\UI-StateIcon"
                            hidden="true"
                            alphaMode="ADD"
                        >
						</Texture>
					</Layer>
                </Layers>
			</Frame>
		</Frames>
	</Button>
</Ui>
